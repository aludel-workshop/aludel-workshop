# Secrets for this Aludel portal. Copy to .env (git-ignored); ./launch-machine loads it.
# Keep both values in your password manager too, so a lost .env is quick to restore.
# The GitHub App's public identifiers (app ID, slug, client ID) are committed in apps/portal/config/github-app.json.

# The GitHub App's client secret (App settings → Client secrets).
MACHINE_GITHUB_CLIENT_SECRET=
# Absolute path to the App's private key (.pem), kept outside this repository.
MACHINE_GITHUB_PRIVATE_KEY_PATH=

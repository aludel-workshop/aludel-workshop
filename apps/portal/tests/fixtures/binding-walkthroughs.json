{
  "about": "LAYER-BINDINGS-01 walkthroughs as data. Each scenario starts from a binding and the entries each participant publishes, then runs steps. evaluate checks the actions in order (kind entry @target <offering spokes); the harness then applies automatic actions as the binding's routine would. resolve closes Work as a person would: accept takes the offered content into the hub, reject sends the hub's version back, choose decides a combine or conflict for one participant's content. edit changes a participant's entries outside Aludel or in its own layer.",
  "scenarios": [
    {
      "name": "Pages first, Design later: one design-system binding, Design joins and takes authority",
      "binding": {
        "id": "bnd-design-system", "concept": { "name": "The app's design system" }, "lifecycle": "active",
        "participants": [
          { "id": "pages-kit", "layer": { "key": "pages" }, "facet": "kit", "role": "authority", "shape": "pages.kit" },
          { "id": "code-ds", "layer": { "key": "platform" }, "facet": "design-system", "role": "replica", "shape": "code.tokens" }
        ],
        "authority": "pages-kit",
        "correspondence": [
          { "key": "color-primary", "refs": { "pages-kit": "kit-primary", "code-ds": "tokens/primary" } },
          { "key": "radius", "refs": { "pages-kit": "kit-radius", "code-ds": "tokens/radius" } }
        ],
        "baseline": {
          "color-primary": { "code-ds": { "hub": "pages-kit", "hubRevision": 1, "self": 1 } },
          "radius": { "code-ds": { "hub": "pages-kit", "hubRevision": 1, "self": 1 } }
        },
        "adapters": [
          { "id": "code-from-pages-kit", "participant": "code-ds", "reads": "pages.kit", "mechanical": true, "soft": false },
          { "id": "code-from-design-kit", "participant": "code-ds", "reads": "design.kit", "mechanical": true, "soft": false },
          { "id": "pages-aludel-kit", "participant": "pages-kit", "reads": "design.kit", "mechanical": true, "soft": false }
        ]
      },
      "snapshots": {
        "pages-kit": [
          { "ref": "kit-primary", "key": "color-primary", "revision": 2, "digest": "#335599" },
          { "ref": "kit-radius", "key": "radius", "revision": 1, "digest": "4px" }
        ],
        "code-ds": [
          { "ref": "tokens/primary", "key": "color-primary", "revision": 1, "digest": "#224488" },
          { "ref": "tokens/radius", "key": "radius", "revision": 1, "digest": "4px" }
        ]
      },
      "steps": [
        { "do": "evaluate", "note": "a token change in the authority applies to Code's replica automatically", "expect": ["apply color-primary @code-ds"] },
        { "do": "evaluate", "note": "applied and recorded: nothing left", "expect": [] },
        { "do": "join", "participant": { "id": "design-kit", "layer": { "key": "design" }, "facet": "kit", "role": "replica", "shape": "design.kit" } },
        { "do": "transfer", "change": { "to": "design-kit", "roles": { "pages-kit": "replica" } },
          "expectWiring": ["code-ds design-kit code-from-design-kit", "pages-kit design-kit pages-aludel-kit"] },
        { "do": "evaluate", "note": "the first reconcile asks Design to take in Pages' choices, one Work item per entry, offered by both spokes",
          "expect": ["adopt color-primary @design-kit <code-ds,pages-kit", "adopt radius @design-kit <code-ds,pages-kit"] },
        { "do": "resolve", "kind": "adopt", "decision": "accept" },
        { "do": "evaluate", "expect": [] },
        { "do": "edit", "participant": "design-kit", "key": "radius", "digest": "6px" },
        { "do": "evaluate", "note": "Design now drives both replicas through their re-pointed adapters", "expect": ["apply radius @code-ds", "apply radius @pages-kit"] },
        { "do": "evaluate", "expect": [] },
        { "do": "edit", "participant": "pages-kit", "key": "radius", "digest": "8px" },
        { "do": "evaluate", "note": "a change to Pages' replica outside the binding is drift; with no drift policy it is assessed", "expect": ["assess radius @work <pages-kit"] },
        { "do": "resolve", "kind": "assess", "decide": "rectify", "expectDecided": ["rectify radius @pages-kit"] },
        { "do": "evaluate", "note": "rectified: the replica follows the authority again", "expect": [], "expectStatus": { "color-primary": "matched", "radius": "matched" } },
        { "do": "addAdapter", "adapter": { "id": "design-from-code-tokens", "participant": "design-kit", "reads": "code.tokens", "mechanical": true, "soft": false } },
        { "do": "setPolicy", "participant": "code-ds", "policy": { "drift": { "changed": "adopt", "removed": "rectify" } } },
        { "do": "edit", "participant": "code-ds", "key": "color-primary", "digest": "#112233" },
        { "do": "evaluate", "note": "a token edited straight in the repository; this contract adopts changed tokens, and Design reads Code's token files mechanically, so the authority updates itself", "expect": ["apply color-primary @design-kit"] },
        { "do": "evaluate", "note": "from the authority, the change reaches the other replica", "expect": ["apply color-primary @pages-kit"] },
        { "do": "remove", "participant": "code-ds", "key": "radius" },
        { "do": "evaluate", "note": "a token deleted in the repository is put back: this contract rectifies removals", "expect": ["rectify radius @code-ds"] },
        { "do": "resolve", "kind": "rectify" },
        { "do": "evaluate", "expect": [], "expectStatus": { "color-primary": "matched", "radius": "matched" } }
      ]
    },
    {
      "name": "A Figma design system joins as the fourth participant and takes authority; Design cedes",
      "binding": {
        "id": "bnd-design-system", "concept": { "name": "The app's design system" }, "lifecycle": "active",
        "participants": [
          { "id": "design-kit", "layer": { "key": "design" }, "facet": "kit", "role": "authority", "shape": "design.kit" },
          { "id": "pages-kit", "layer": { "key": "pages" }, "facet": "kit", "role": "replica", "shape": "pages.kit" },
          { "id": "code-ds", "layer": { "key": "platform" }, "facet": "design-system", "role": "replica", "shape": "code.tokens" }
        ],
        "authority": "design-kit",
        "correspondence": [
          { "key": "color-primary", "refs": { "design-kit": "tok-primary", "pages-kit": "kit-primary", "code-ds": "tokens/primary" } }
        ],
        "baseline": {
          "color-primary": {
            "pages-kit": { "hub": "design-kit", "hubRevision": 3, "self": 2 },
            "code-ds": { "hub": "design-kit", "hubRevision": 3, "self": 4 }
          }
        },
        "adapters": [
          { "id": "pages-aludel-kit", "participant": "pages-kit", "reads": "design.kit", "mechanical": true, "soft": false },
          { "id": "code-from-design-kit", "participant": "code-ds", "reads": "design.kit", "mechanical": true, "soft": false },
          { "id": "code-from-figma", "participant": "code-ds", "reads": "figma.variables", "mechanical": true, "soft": false }
        ]
      },
      "snapshots": {
        "design-kit": [{ "ref": "tok-primary", "key": "color-primary", "revision": 3, "digest": "#335599" }, { "ref": "tok-legacy", "key": "legacy-shadow", "revision": 1, "digest": "soft" }],
        "pages-kit": [{ "ref": "kit-primary", "key": "color-primary", "revision": 2, "digest": "#335599" }],
        "code-ds": [{ "ref": "tokens/primary", "key": "color-primary", "revision": 4, "digest": "#335599" }],
        "figma": [
          { "ref": "VariableID:1:2", "key": "color-primary", "revision": 7, "digest": "#335599" },
          { "ref": "VariableID:1:9", "key": "spacing-base", "revision": 3, "digest": "8px" }
        ]
      },
      "steps": [
        { "do": "evaluate", "note": "Design's unshared token goes to the replicas while Design is the authority",
          "expect": ["apply legacy-shadow @code-ds", "apply legacy-shadow @pages-kit"] },
        { "do": "join", "participant": { "id": "figma", "layer": { "key": "figma_import" }, "facet": "variables", "role": "replica", "shape": "figma.variables" } },
        { "do": "transfer", "change": { "to": "figma", "roles": { "design-kit": "ceded" } },
          "expectWiring": ["code-ds figma code-from-figma", "pages-kit figma null"] },
        { "do": "evaluate", "note": "equal content needs no Work; Pages has no adapter for Figma's own shape yet, so it gets Work to write one; the ceded Design facet offers its content once, then takes no part",
          "expect": ["ignored color-primary @code-ds", "ignored color-primary @design-kit", "ignored color-primary @pages-kit", "adopt legacy-shadow @figma <code-ds,design-kit,pages-kit", "apply spacing-base @code-ds", "adapter spacing-base @pages-kit"] },
        { "do": "resolve", "kind": "adopt", "decision": "reject" },
        { "do": "evaluate", "note": "Figma keeps what it has; the replicas drop the token only Design had",
          "expect": ["apply legacy-shadow @code-ds", "adapter legacy-shadow,spacing-base @pages-kit"] },
        { "do": "addAdapter", "adapter": { "id": "pages-from-figma", "participant": "pages-kit", "reads": "figma.variables", "mechanical": true, "soft": false } },
        { "do": "evaluate", "expect": ["apply legacy-shadow @pages-kit", "apply spacing-base @pages-kit"] },
        { "do": "evaluate", "expect": [] }
      ]
    },
    {
      "name": "An existing app and a blank Pages: user journeys with Pages as the authority",
      "binding": {
        "id": "bnd-user-journeys", "concept": { "name": "The app's user journeys" }, "lifecycle": "reconciling",
        "participants": [
          { "id": "pages-flows", "layer": { "key": "pages" }, "facet": "flows", "role": "authority", "shape": "pages.flows" },
          { "id": "code-routes", "layer": { "key": "platform" }, "facet": "routes", "role": "replica", "shape": "code.routes" }
        ],
        "authority": "pages-flows",
        "policy": { "code-routes": { "drift": { "added": "adopt", "changed": "assess", "removed": "rectify" } } },
        "adapters": [
          { "id": "code-flow-tests", "participant": "code-routes", "reads": "pages.flows", "mechanical": true, "soft": true }
        ]
      },
      "snapshots": {
        "pages-flows": [],
        "code-routes": [
          { "ref": "app/login/page.tsx", "key": "sign-in", "revision": 1, "digest": "sign-in:/login" },
          { "ref": "app/borrow/page.tsx", "key": "borrow-a-tool", "revision": 1, "digest": "borrow:/borrow,/borrow/confirm" },
          { "ref": "app/lend/page.tsx", "key": "lend-a-tool", "revision": 1, "digest": "lend:/lend" }
        ]
      },
      "steps": [
        { "do": "evaluate", "note": "everything is only on Code's side: Pages drafts flows from the observations, for the designer to review",
          "expect": ["adopt borrow-a-tool @pages-flows <code-routes", "adopt lend-a-tool @pages-flows <code-routes", "adopt sign-in @pages-flows <code-routes"],
          "expectFirst": true },
        { "do": "resolve", "kind": "adopt", "decision": "accept" },
        { "do": "evaluate", "expect": [], "expectStatus": { "borrow-a-tool": "matched", "lend-a-tool": "matched", "sign-in": "matched" } },
        { "do": "edit", "participant": "code-routes", "key": "borrow-a-tool", "digest": "borrow:/borrow" },
        { "do": "evaluate", "note": "a commit outside the normal process changes a journey; this contract has changed journeys assessed", "expect": ["assess borrow-a-tool @work <code-routes"] },
        { "do": "resolve", "kind": "assess", "decide": "rectify", "expectDecided": ["rectify borrow-a-tool @code-routes"] },
        { "do": "evaluate", "expect": [] },
        { "do": "edit", "participant": "code-routes", "key": "borrow-a-tool", "digest": "borrow:/borrow,/borrow/confirm,/borrow/deposit" },
        { "do": "evaluate", "expect": ["assess borrow-a-tool @work <code-routes"] },
        { "do": "resolve", "kind": "assess", "decide": "adopt", "expectDecided": ["adopt borrow-a-tool @pages-flows <code-routes"] },
        { "do": "evaluate", "note": "adopted: the flow now describes the deposit step the commit added", "expect": [] },
        { "do": "add", "participant": "code-routes", "ref": "app/damage/page.tsx", "key": "report-damage", "digest": "damage:/damage" },
        { "do": "evaluate", "note": "a new journey added straight to the code is adopted by contract; Pages has no mechanical reader of routes, so the designer drafts the flow", "expect": ["adopt report-damage @pages-flows <code-routes"] },
        { "do": "resolve", "kind": "adopt", "decision": "accept" },
        { "do": "remove", "participant": "code-routes", "key": "lend-a-tool" },
        { "do": "evaluate", "note": "a journey deleted outside the process is rectified: Code gets Work to restore it", "expect": ["rectify lend-a-tool @code-routes"] },
        { "do": "resolve", "kind": "rectify" },
        { "do": "evaluate", "expect": [] }
      ]
    },
    {
      "name": "An existing app and a blank Pages, in a project that chose code as the authority",
      "binding": {
        "id": "bnd-user-journeys", "concept": { "name": "The app's user journeys" }, "lifecycle": "reconciling",
        "participants": [
          { "id": "pages-flows", "layer": { "key": "pages" }, "facet": "flows", "role": "replica", "shape": "pages.flows" },
          { "id": "code-routes", "layer": { "key": "platform" }, "facet": "routes", "role": "authority", "shape": "code.routes" }
        ],
        "authority": "code-routes",
        "adapters": [
          { "id": "pages-flows-from-routes", "participant": "pages-flows", "reads": "code.routes", "mechanical": false, "soft": true }
        ]
      },
      "snapshots": {
        "pages-flows": [],
        "code-routes": [
          { "ref": "app/login/page.tsx", "key": "sign-in", "revision": 1, "digest": "sign-in:/login" },
          { "ref": "app/borrow/page.tsx", "key": "borrow-a-tool", "revision": 1, "digest": "borrow:/borrow" }
        ]
      },
      "steps": [
        { "do": "evaluate", "note": "update Work for Pages directly", "expect": ["import borrow-a-tool @pages-flows", "import sign-in @pages-flows"] },
        { "do": "resolve", "kind": "import", "decision": "accept" },
        { "do": "evaluate", "expect": [] }
      ]
    },
    {
      "name": "Flows first, then code",
      "binding": {
        "id": "bnd-user-journeys", "concept": { "name": "The app's user journeys" }, "lifecycle": "reconciling",
        "participants": [
          { "id": "pages-flows", "layer": { "key": "pages" }, "facet": "flows", "role": "authority", "shape": "pages.flows" },
          { "id": "code-routes", "layer": { "key": "platform" }, "facet": "routes", "role": "replica", "shape": "code.routes" }
        ],
        "authority": "pages-flows",
        "adapters": [
          { "id": "code-flow-tests", "participant": "code-routes", "reads": "pages.flows", "mechanical": true, "soft": true }
        ]
      },
      "snapshots": {
        "pages-flows": [
          { "ref": "flw-borrow", "key": "borrow-a-tool", "revision": 2, "digest": "borrow:/borrow" },
          { "ref": "flw-sign-in", "key": "sign-in", "revision": 1, "digest": "sign-in:/login" }
        ],
        "code-routes": []
      },
      "steps": [
        { "do": "evaluate", "note": "Code imports the flows as end-to-end tests (mechanical) and implements them (Work)",
          "expect": ["apply borrow-a-tool @code-routes", "import borrow-a-tool @code-routes", "apply sign-in @code-routes", "import sign-in @code-routes"] },
        { "do": "evaluate", "note": "a replay before the Work closes raises the same actions, with the same IDs, so nothing is duplicated", "expectSameIds": true,
          "expect": ["apply borrow-a-tool @code-routes", "import borrow-a-tool @code-routes", "apply sign-in @code-routes", "import sign-in @code-routes"], "noApply": true },
        { "do": "resolve", "kind": "import", "decision": "accept" },
        { "do": "evaluate", "expect": [] }
      ]
    },
    {
      "name": "Both developed: the first reconcile is the merge",
      "binding": {
        "id": "bnd-user-journeys", "concept": { "name": "The app's user journeys" }, "lifecycle": "reconciling",
        "participants": [
          { "id": "pages-flows", "layer": { "key": "pages" }, "facet": "flows", "role": "authority", "shape": "pages.flows" },
          { "id": "code-routes", "layer": { "key": "platform" }, "facet": "routes", "role": "replica", "shape": "code.routes" }
        ],
        "authority": "pages-flows",
        "adapters": [
          { "id": "code-flow-tests", "participant": "code-routes", "reads": "pages.flows", "mechanical": true, "soft": true },
          { "id": "pages-flows-from-routes", "participant": "pages-flows", "reads": "code.routes", "mechanical": false, "soft": true }
        ]
      },
      "snapshots": {
        "pages-flows": [
          { "ref": "flw-sign-in", "key": "sign-in", "revision": 3, "digest": "sign-in:/login" },
          { "ref": "flw-borrow", "key": "borrow-a-tool", "revision": 2, "digest": "borrow:/borrow,/borrow/confirm" },
          { "ref": "flw-return", "key": "return-a-tool", "revision": 1, "digest": "return:/return" }
        ],
        "code-routes": [
          { "ref": "app/login/page.tsx", "key": "sign-in", "revision": 5, "digest": "sign-in:/login" },
          { "ref": "app/borrow/page.tsx", "key": "borrow-a-tool", "revision": 2, "digest": "borrow:/borrow" },
          { "ref": "app/lend/page.tsx", "key": "lend-a-tool", "revision": 1, "digest": "lend:/lend" }
        ]
      },
      "steps": [
        {
          "do": "evaluate", "note": "matched, only on one side and diverged entries become combine, trim or add Work",
          "expect": [
            "combine borrow-a-tool @pages-flows <code-routes",
            "adopt lend-a-tool @pages-flows <code-routes",
            "apply return-a-tool @code-routes",
            "import return-a-tool @code-routes",
            "ignored sign-in @code-routes"
          ]
        },
        { "do": "resolve", "kind": "combine", "choose": "pages-flows" },
        { "do": "resolve", "kind": "adopt", "decision": "accept" },
        { "do": "resolve", "kind": "import", "decision": "accept" },
        {
          "do": "evaluate", "note": "the designer's version of borrowing goes to Code",
          "expect": ["apply borrow-a-tool @code-routes", "import borrow-a-tool @code-routes"]
        },
        { "do": "resolve", "kind": "import", "decision": "accept" },
        { "do": "evaluate", "expect": [] },
        { "do": "edit", "participant": "pages-flows", "key": "lend-a-tool", "digest": "lend:/lend,/lend/photos" },
        { "do": "edit", "participant": "code-routes", "key": "lend-a-tool", "digest": "lend:/lend/new" },
        { "do": "evaluate", "note": "both changed since the baseline: a person decides", "expect": ["conflict lend-a-tool @pages-flows <code-routes"] }
      ]
    },
    {
      "name": "A Branding layer takes over branding: after refaceting, Design keeps name and mark as a replica, cedes the rest, and Pages' brand kit follows",
      "about": "Design was refaceted (kit → kit + identity + brand, within brand_asset by key) and Pages too (kit → kit + kit-brand); the design-system binding keeps both kits untouched. The split-off facets were unbound, so this is a new binding with Branding as its authority from the start.",
      "binding": {
        "id": "bnd-branding", "concept": { "name": "The app's branding" }, "lifecycle": "reconciling",
        "participants": [
          { "id": "branding", "layer": { "key": "branding" }, "facet": "brand", "role": "authority", "shape": "branding.brand" },
          { "id": "design-identity", "layer": { "key": "design" }, "facet": "identity", "role": "replica", "shape": "design.identity" },
          { "id": "design-brand", "layer": { "key": "design" }, "facet": "brand", "role": "ceded", "shape": "design.brand" },
          { "id": "pages-kit-brand", "layer": { "key": "pages" }, "facet": "kit-brand", "role": "replica", "shape": "pages.kit-brand" }
        ],
        "authority": "branding",
        "policy": { "design-identity": { "added": "ignore" } },
        "adapters": [
          { "id": "design-identity-from-branding", "participant": "design-identity", "reads": "branding.brand", "mechanical": true, "soft": false },
          { "id": "pages-aludel-kit", "participant": "pages-kit-brand", "reads": "design.kit", "mechanical": true, "soft": false }
        ]
      },
      "snapshots": {
        "design-identity": [{ "ref": "brd-name", "key": "app-name", "revision": 1, "digest": "Tool Share" }, { "ref": "brd-mark", "key": "mark", "revision": 1, "digest": "mark-v1" }],
        "design-brand": [{ "ref": "brd-voice", "key": "voice", "revision": 1, "digest": "friendly" }, { "ref": "brd-story", "key": "palette-story", "revision": 1, "digest": "warm" }],
        "pages-kit-brand": [{ "ref": "kit-name", "key": "app-name", "revision": 1, "digest": "Tool Share" }, { "ref": "kit-mark", "key": "mark", "revision": 1, "digest": "mark-v1" }],
        "branding": [
          { "ref": "name", "key": "app-name", "revision": 1, "digest": "Tool Share" },
          { "ref": "mark", "key": "mark", "revision": 1, "digest": "mark-v2" },
          { "ref": "tagline", "key": "tagline", "revision": 1, "digest": "Borrow, don't buy" }
        ]
      },
      "steps": [
        {
          "do": "evaluate",
          "note": "Design's ceded voice and palette story are offered to Branding once; the two marks differ, so a person combines them; Design's identity ignores what it never keeps; Pages needs an adapter for Branding's shape",
          "expect": [
            "ignored app-name @design-identity",
            "ignored app-name @pages-kit-brand",
            "combine mark @branding <design-identity,pages-kit-brand",
            "adopt palette-story @branding <design-brand",
            "adapter tagline @pages-kit-brand",
            "ignored tagline @design-identity",
            "adopt voice @branding <design-brand"
          ],
          "expectFirst": true
        },
        { "do": "resolve", "kind": "combine", "choose": "branding" },
        { "do": "resolve", "kind": "adopt", "decision": "accept" },
        {
          "do": "evaluate", "note": "Design's identity takes the new mark; nothing flows into what Design ceded",
          "expect": [
            "apply mark @design-identity",
            "adapter mark,palette-story,tagline,voice @pages-kit-brand",
            "ignored palette-story @design-identity",
            "ignored voice @design-identity"
          ]
        },
        { "do": "addAdapter", "adapter": { "id": "pages-from-branding", "participant": "pages-kit-brand", "reads": "branding.brand", "mechanical": true, "soft": false } },
        {
          "do": "evaluate",
          "expect": ["apply mark @pages-kit-brand", "apply palette-story @pages-kit-brand", "apply tagline @pages-kit-brand", "apply voice @pages-kit-brand"]
        },
        { "do": "evaluate", "expect": [], "expectStatus": { "app-name": "matched", "mark": "matched", "voice": "matched", "tagline": "matched" } },
        { "do": "edit", "participant": "branding", "key": "voice", "digest": "plain" },
        {
          "do": "evaluate", "note": "Design's ceded voice is history: only Pages takes the change",
          "expect": ["apply voice @pages-kit-brand", "ignored voice @design-identity"]
        },
        { "do": "edit", "participant": "design-brand", "key": "voice", "digest": "edited anyway" },
        { "do": "evaluate", "note": "a ceded participant's later edit (one the write guard should have refused) is not drift: it is history", "expect": [] }
      ]
    }
  ]
}

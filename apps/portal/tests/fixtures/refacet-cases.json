          { "id": "vision-personas", "layer": { "key": "vision" }, "facet": "personas", "role": "ceded", "shape": "vision.personas" }
        ],
        "authority": "personas-people",
        "correspondence": [
          { "key": "borrower", "refs": { "personas-people": "personas:borrower", "vision-personas": "per-borrower" } },
          { "key": "maker", "refs": { "personas-people": "personas:maker", "vision-personas": "per-maker" } }
        ],
        "baseline": {
          "borrower": { "vision-personas": { "hub": "personas-people", "hubRevision": 1, "self": 1 } },
          "maker": { "vision-personas": { "hub": "personas-people", "hubRevision": 1, "self": 1 } }
        },
        "adapters": [
          { "id": "people-from-vision", "participant": "personas-people", "reads": "vision.personas", "mechanical": false, "soft": true },
          { "id": "personas-from-people", "participant": "vision-personas", "reads": "personas.people", "mechanical": false, "soft": true }
        ]
      }],
      "references": [],
      "steps": [
        { "do": "evaluate", "binding": "bnd-personas", "note": "Vision's ceded personas take nothing while Personas holds authority", "expect": [] },
        { "do": "refacet", "layer": "vision", "change": { "op": "merge", "facet": "intent", "from": "personas" }, "expectError": "takes part in bnd-personas" },
        { "do": "transfer", "binding": "bnd-personas", "change": { "to": "vision-personas", "roles": { "personas-people": "ceded" } } },
        { "do": "evaluate", "binding": "bnd-personas", "note": "Personas offers what it holds once: its newer maker conflicts with Vision's history, the lender is new",
          "expect": ["ignored borrower @personas-people", "adopt lender @vision-personas <personas-people", "combine maker @vision-personas <personas-people"], "expectAdapter": "personas-from-people" },
        { "do": "resolve", "binding": "bnd-personas", "kind": "combine", "choose": "personas-people" },
        { "do": "resolve", "binding": "bnd-personas", "kind": "adopt", "decision": "accept" },
        { "do": "evaluate", "binding": "bnd-personas", "expect": [] },
        { "do": "retire", "binding": "bnd-personas" },
        { "do": "refacet", "layer": "vision", "change": { "op": "merge", "facet": "intent", "from": "personas" },
          "expectPreflight": { "records": ["per-borrower", "per-maker", "vision:lender"], "bindings": [], "follow": [], "facets": ["intent:4:"] } },
        { "do": "select", "layer": "vision", "expect": { "intent": [{ "kind": "vision_section" }, { "kind": "persona" }] } },
        { "do": "facets", "layer": "vision", "expect": { "intent": ["per-borrower", "per-maker", "sec-problem", "vision:lender"] } },
        { "do": "role", "layer": "vision", "ref": "per-maker", "expect": { "facet": "intent", "role": null, "binding": null } }

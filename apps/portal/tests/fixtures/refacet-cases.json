{
  "about": "LAYER-BINDINGS-01 step 3 (refaceting) as data. Each case starts from installed layers (their outputs, declared facets and current entries), live bindings and cross-layer references, then runs steps. A participant's snapshot is its layer's entries that fall in its facet, so refaceting changes what a binding sees exactly as the host will. refacet checks the preflight its Work item shows (records that move, bindings that keep them detached, other participants that should follow, references into the moving part, each facet's entries and bindings). evaluate, resolve, transfer and edit work as in binding-walkthroughs.json. repoint checks the Work that re-points references into a ceded facet. role checks what an entry is: its facet, that facet's role, and its binding.",
  "cases": [
    {
      "name": "Vision cedes its personas to a new Personas layer: refacet by kind, cede, adopt through Personas' adapter, then re-point Pages' references",
      "layers": {
        "vision": {
          "outputs": ["vision_section", "brief_claim", "story", "persona"],
          "facets": [{ "key": "intent", "title": "Product intent", "kinds": ["vision_section", "brief_claim", "story", "persona"], "roles": ["authority", "replica", "ceded"] }],
          "entries": [
            { "ref": "sec-problem", "kind": "vision_section", "revision": 2, "digest": "problem" },
            { "ref": "per-maker", "kind": "persona", "key": "maker", "revision": 1, "digest": "Maker: builds things" },
            { "ref": "per-borrower", "kind": "persona", "key": "borrower", "revision": 1, "digest": "Borrower: needs a tool once" }
          ]
        },
        "personas": {
          "outputs": ["person"],
          "facets": [{ "key": "people", "title": "People", "select": [{ "kind": "person" }], "roles": ["authority"] }],
          "entries": []
        },
        "pages": {
          "outputs": ["page", "flow"],
          "facets": [{ "key": "pages", "title": "Pages", "kinds": ["page", "flow"], "roles": ["authority"] }],
          "entries": [{ "ref": "pg-home", "kind": "page", "revision": 1, "digest": "home" }, { "ref": "flw-borrow", "kind": "flow", "revision": 1, "digest": "borrow" }]
        }
      },
      "bindings": [],
      "references": [{ "layer": "pages", "entry": "pg-home", "to": "per-maker" }, { "layer": "pages", "entry": "flw-borrow", "to": "per-borrower" }],
      "steps": [
        { "do": "refacet", "layer": "vision", "change": { "op": "split", "facet": "intent", "into": { "key": "personas", "title": "Personas", "take": [{ "kind": "persona" }] } },
          "expectPreflight": { "records": ["per-borrower", "per-maker"], "follow": [], "bindings": [],
            "references": ["pages/flw-borrow>per-borrower", "pages/pg-home>per-maker"], "facets": ["intent:1:", "personas:2:"] } },
        { "do": "facets", "layer": "vision", "expect": { "intent": ["sec-problem"], "personas": ["per-borrower", "per-maker"] } },
        { "do": "role", "layer": "vision", "ref": "per-maker", "expect": { "facet": "personas", "role": null, "binding": null } },
        { "do": "propose", "binding": {
          "id": "bnd-personas", "concept": { "name": "The app's personas" }, "lifecycle": "reconciling",
          "participants": [
            { "id": "personas-people", "layer": { "key": "personas" }, "facet": "people", "role": "authority", "shape": "personas.people" },
            { "id": "vision-personas", "layer": { "key": "vision" }, "facet": "personas", "role": "ceded", "shape": "vision.personas" }
          ],
          "authority": "personas-people",
          "adapters": [{ "id": "people-from-vision", "participant": "personas-people", "reads": "vision.personas", "mechanical": false, "soft": true }] } },
        { "do": "evaluate", "binding": "bnd-personas", "note": "Vision's personas are offered once, in Vision's own shape, through the adapter Personas owns",
          "expect": ["adopt borrower @personas-people <vision-personas", "adopt maker @personas-people <vision-personas"], "expectAdapter": "people-from-vision" },
        { "do": "resolve", "binding": "bnd-personas", "kind": "adopt", "decision": "accept" },
        { "do": "evaluate", "binding": "bnd-personas", "expect": [], "expectStatus": { "maker": "matched", "borrower": "matched" } },
        { "do": "role", "layer": "vision", "ref": "per-maker", "expect": { "facet": "personas", "role": "ceded", "binding": "bnd-personas", "authority": { "participant": "personas-people", "layer": "personas", "facet": "people" } } },
        { "do": "role", "layer": "vision", "ref": "sec-problem", "expect": { "facet": "intent", "role": null, "binding": null } },
        { "do": "role", "layer": "personas", "ref": "personas:maker", "expect": { "facet": "people", "role": "authority", "binding": "bnd-personas", "authority": { "participant": "personas-people", "layer": "personas", "facet": "people" } } },
        { "do": "repoint", "binding": "bnd-personas", "from": "vision-personas", "accepts": { "pages": ["persona"] },
          "note": "Pages checks audiences against the persona kind, and Personas keeps people: adapter Work, not a silent rewrite",
          "expect": ["adapter @pages flw-borrow:per-borrower>personas:borrower,pg-home:per-maker>personas:maker"] },
        { "do": "repoint", "binding": "bnd-personas", "from": "vision-personas", "accepts": { "pages": "*" },
          "note": "once Pages references by Library pin, the same references are re-pointed",
          "expect": ["repoint @pages flw-borrow:per-borrower>personas:borrower,pg-home:per-maker>personas:maker"] },
        { "do": "edit", "binding": "bnd-personas", "participant": "personas-people", "key": "maker", "digest": "Maker: builds and lends" },
        { "do": "evaluate", "binding": "bnd-personas", "note": "a ceded facet takes nothing from its authority", "expect": [] }
      ]
    },
    {
      "name": "Design's branding goes to a Branding layer built from scratch: refacet within a kind, Pages' kit refaceted too, the design-system binding untouched",
      "layers": {
        "design": {
          "outputs": ["design_tokens", "component", "brand_asset"],
          "facets": [{ "key": "kit", "title": "Design system", "kinds": ["design_tokens", "component", "brand_asset"], "roles": ["authority", "replica", "ceded"], "shape": "design.kit" }],
          "entries": [
            { "ref": "tok-primary", "kind": "design_tokens", "key": "color-primary", "revision": 1, "digest": "#335599" },
            { "ref": "brd-name", "kind": "brand_asset", "key": "app-name", "data": { "key": "name" }, "revision": 1, "digest": "Tool Share" },
            { "ref": "brd-mark", "kind": "brand_asset", "key": "mark", "data": { "key": "mark" }, "revision": 1, "digest": "mark-v1" },
            { "ref": "brd-voice", "kind": "brand_asset", "key": "voice", "data": { "key": "voice" }, "revision": 1, "digest": "friendly" }
          ]
        },
        "pages": {
          "outputs": ["kit_item", "page"],
          "facets": [{ "key": "kit", "title": "App kit", "kinds": ["kit_item"], "roles": ["replica"], "shape": "pages.kit" }],
          "entries": [
            { "ref": "kit-primary", "kind": "kit_item", "key": "color-primary", "data": { "group": "tokens" }, "revision": 1, "digest": "#335599" },
            { "ref": "kit-name", "kind": "kit_item", "key": "app-name", "data": { "group": "brand" }, "revision": 1, "digest": "Tool Share" },
            { "ref": "kit-mark", "kind": "kit_item", "key": "mark", "data": { "group": "brand" }, "revision": 1, "digest": "mark-v1" },
            { "ref": "kit-voice", "kind": "kit_item", "key": "voice", "data": { "group": "brand" }, "revision": 1, "digest": "friendly" }
          ]
        },
        "branding": {
          "outputs": ["brand_item"],
          "facets": [{ "key": "brand", "title": "Brand", "select": [{ "kind": "brand_item" }], "roles": ["authority"], "shape": "branding.brand" }],
          "entries": [
            { "ref": "name", "kind": "brand_item", "key": "app-name", "revision": 1, "digest": "Tool Share" },
            { "ref": "mark", "kind": "brand_item", "key": "mark", "revision": 1, "digest": "mark-v2" },
            { "ref": "tagline", "kind": "brand_item", "key": "tagline", "revision": 1, "digest": "Borrow, don't buy" }
          ]
        }
      },
      "bindings": [{
        "id": "bnd-design-system", "concept": { "name": "The app's design system" }, "lifecycle": "active",
        "participants": [
          { "id": "design-kit", "layer": { "key": "design" }, "facet": "kit", "role": "authority", "shape": "design.kit" },
          { "id": "pages-kit", "layer": { "key": "pages" }, "facet": "kit", "role": "replica", "shape": "pages.kit" }
        ],
        "authority": "design-kit",
        "correspondence": [
          { "key": "app-name", "refs": { "design-kit": "brd-name", "pages-kit": "kit-name" } },
          { "key": "color-primary", "refs": { "design-kit": "tok-primary", "pages-kit": "kit-primary" } },
          { "key": "mark", "refs": { "design-kit": "brd-mark", "pages-kit": "kit-mark" } },
          { "key": "voice", "refs": { "design-kit": "brd-voice", "pages-kit": "kit-voice" } }
        ],
        "baseline": {
          "app-name": { "pages-kit": { "hub": "design-kit", "hubRevision": 1, "self": 1 } },
          "color-primary": { "pages-kit": { "hub": "design-kit", "hubRevision": 1, "self": 1 } },
          "mark": { "pages-kit": { "hub": "design-kit", "hubRevision": 1, "self": 1 } },
          "voice": { "pages-kit": { "hub": "design-kit", "hubRevision": 1, "self": 1 } }
        },
        "adapters": [{ "id": "pages-aludel-kit", "participant": "pages-kit", "reads": "design.kit", "mechanical": true, "soft": false }]
      }],
      "references": [],
      "steps": [
        { "do": "evaluate", "binding": "bnd-design-system", "expect": [] },
        { "do": "refacet", "layer": "design", "change": { "op": "split", "facet": "kit", "into": { "key": "identity", "title": "Name and mark", "take": [{ "kind": "brand_asset", "where": { "field": "key", "in": ["name", "mark"] } }] } },
          "note": "the name and mark leave the design-system binding there, and Pages, which still holds them, should follow",
          "expectPreflight": { "records": ["brd-mark", "brd-name"], "bindings": ["bnd-design-system:app-name,mark"],
            "follow": ["bnd-design-system pages-kit pages/kit replica kit-mark,kit-name"], "references": [], "facets": ["kit:2:bnd-design-system", "identity:2:"] } },
        { "do": "refacet", "layer": "design", "change": { "op": "split", "facet": "kit", "into": { "key": "brand", "title": "Brand", "take": [{ "kind": "brand_asset" }] } },
          "note": "taking a kind as the facet now holds it: every brand asset but the name and mark",
          "expectPreflight": { "records": ["brd-voice"], "bindings": ["bnd-design-system:app-name,mark,voice"],
            "follow": ["bnd-design-system pages-kit pages/kit replica kit-voice"], "facets": ["kit:1:bnd-design-system", "brand:1:", "identity:2:"] } },
        { "do": "select", "layer": "design", "expect": {
          "kit": [{ "kind": "design_tokens" }, { "kind": "component" }],
          "identity": [{ "kind": "brand_asset", "where": { "field": "key", "in": ["mark", "name"] } }],
          "brand": [{ "kind": "brand_asset", "where": { "field": "key", "notIn": ["mark", "name"] } }] } },
        { "do": "evaluate", "binding": "bnd-design-system", "note": "Pages still holds the brand entries, which are detached: not a removal on Design's side, not drift on Pages'",
          "expect": [], "expectStatus": { "color-primary": "matched", "app-name": "detached", "mark": "detached", "voice": "detached" }, "expectDetached": ["app-name:pages-kit", "mark:pages-kit", "voice:pages-kit"] },
        { "do": "refacet", "layer": "pages", "change": { "op": "split", "facet": "kit", "into": { "key": "kit-brand", "title": "Brand kit", "take": [{ "kind": "kit_item", "where": { "field": "group", "equals": "brand" } }] } },
          "note": "Pages' kit would straddle two authorities, so it is refaceted too; its brand entries were already detached",
          "expectPreflight": { "records": ["kit-mark", "kit-name", "kit-voice"], "bindings": [], "follow": [], "facets": ["kit:1:bnd-design-system", "kit-brand:3:"] } },
        { "do": "evaluate", "binding": "bnd-design-system", "note": "nobody holds the detached entries any more", "expect": [], "expectDetached": [] },
        { "do": "propose", "binding": {
          "id": "bnd-branding", "concept": { "name": "The app's branding" }, "lifecycle": "reconciling",
          "participants": [
            { "id": "branding", "layer": { "key": "branding" }, "facet": "brand", "role": "authority", "shape": "branding.brand" },
            { "id": "design-identity", "layer": { "key": "design" }, "facet": "identity", "role": "replica", "shape": "design.identity" },
            { "id": "design-brand", "layer": { "key": "design" }, "facet": "brand", "role": "ceded", "shape": "design.brand" },
            { "id": "pages-kit-brand", "layer": { "key": "pages" }, "facet": "kit-brand", "role": "replica", "shape": "pages.kit-brand" }
          ],
          "authority": "branding",
          "policy": { "design-identity": { "added": "ignore" } },
          "adapters": [
            { "id": "identity-from-branding", "participant": "design-identity", "reads": "branding.brand", "mechanical": true, "soft": false },
            { "id": "kit-from-branding", "participant": "pages-kit-brand", "reads": "branding.brand", "mechanical": true, "soft": false }
          ] } },
        { "do": "evaluate", "binding": "bnd-branding", "note": "the marks differ, so a person combines them; Design's ceded voice and Pages' copy of it go to Branding; Design's identity ignores what it never keeps",
          "expect": ["ignored app-name @design-identity", "ignored app-name @pages-kit-brand", "combine mark @branding <design-identity,pages-kit-brand",
            "apply tagline @pages-kit-brand", "ignored tagline @design-identity", "adopt voice @branding <design-brand,pages-kit-brand"] },
        { "do": "resolve", "binding": "bnd-branding", "kind": "combine", "choose": "branding" },
        { "do": "resolve", "binding": "bnd-branding", "kind": "adopt", "decision": "accept" },
        { "do": "evaluate", "binding": "bnd-branding", "expect": ["apply mark @design-identity", "apply mark @pages-kit-brand", "ignored voice @design-identity"] },
        { "do": "evaluate", "binding": "bnd-branding", "expect": [], "expectStatus": { "app-name": "matched", "mark": "matched", "tagline": "matched", "voice": "matched" } },
        { "do": "evaluate", "binding": "bnd-design-system", "expect": [] },
        { "do": "facets", "layer": "pages", "expect": { "kit": ["kit-primary"], "kit-brand": ["kit-mark", "kit-name", "kit-voice", "pages:tagline"] } },
        { "do": "role", "layer": "design", "ref": "brd-voice", "expect": { "facet": "brand", "role": "ceded", "binding": "bnd-branding", "authority": { "participant": "branding", "layer": "branding", "facet": "brand" } } },
        { "do": "role", "layer": "design", "ref": "tok-primary", "expect": { "facet": "kit", "role": "authority", "binding": "bnd-design-system", "authority": { "participant": "design-kit", "layer": "design", "facet": "kit" } } },
        { "do": "role", "layer": "pages", "ref": "kit-name", "expect": { "facet": "kit-brand", "role": "replica", "binding": "bnd-branding", "authority": { "participant": "branding", "layer": "branding", "facet": "brand" } } }
      ]
    },
    {

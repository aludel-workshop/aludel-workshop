        { "do": "resolve", "binding": "bnd-marketing-copy", "kind": "combine", "choose": "content-web" },
        { "do": "evaluate", "binding": "bnd-marketing-copy", "note": "copy into page sections is soft: Work in Pages", "expect": ["import home-hero @pages-marketing"] },

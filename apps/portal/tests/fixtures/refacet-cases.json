      "steps": [
        { "do": "refacet", "layer": "content", "change": { "op": "split", "facet": "copy", "into": { "key": "web-copy", "title": "Web copy", "take": [{ "kind": "copy", "where": { "field": "channel", "equals": "web" } }] } },
          "expectPreflight": { "records": ["cp-faq", "cp-hero"], "bindings": [], "follow": [], "facets": ["copy:1:", "web-copy:2:"] } },
        { "do": "refacet", "layer": "pages", "change": { "op": "split", "facet": "pages", "into": { "key": "marketing", "title": "Marketing pages", "take": [{ "kind": "page", "where": { "field": "template", "equals": "marketing" } }] } },
          "expectPreflight": { "records": ["pg-faq", "pg-home"], "bindings": [], "follow": [], "facets": ["pages:2:", "marketing:2:"] } },
        { "do": "propose", "binding": {
          "id": "bnd-marketing-copy", "concept": { "name": "Marketing copy" }, "lifecycle": "reconciling",
          "participants": [

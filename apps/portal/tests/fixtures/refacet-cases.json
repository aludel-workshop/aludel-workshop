          "entries": [
            { "ref": "cp-hero", "kind": "copy", "key": "home-hero", "data": { "channel": "web" }, "revision": 2, "digest": "Borrow tools from your neighbours" },
            { "ref": "cp-faq", "kind": "copy", "key": "faq", "data": { "channel": "web" }, "revision": 1, "digest": "faq-v1" },

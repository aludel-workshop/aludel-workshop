{
  "name": "aludel-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "serve": "node server/server.mjs",
    "start": "npm run build && node server/server.mjs",
    "reset-owner": "node server/server.mjs --reset-owner",
    "test:server": "node --test --test-timeout=300000 tests/*.test.mjs",
    "build": "vite build",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "sync:layers": "node tools/sync-layer-template.mjs",
    "prebuild": "npm run sync:layers",
    "pretypecheck": "npm run sync:layers",
    "predev": "npm run sync:layers",
    "test:server:templates": "MACHINE_LAYER_TEMPLATES_ENABLED=1 node --test --test-timeout=300000 tests/*.test.mjs",
    "test:affected": "node tools/test-affected.mjs"
  },
  "dependencies": {
    "@angular/animations": "22.1.7",
    "@angular/cdk": "22.1.7",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/material": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@anthropic-ai/sdk": "0.128.0",
    "@dicebear/big-smile": "9.4.3",
    "@dicebear/bottts-neutral": "9.4.3",
    "@dicebear/core": "9.4.3",
    "@fontsource/roboto": "5.3.0",
    "material-symbols": "0.40.2",
    "rxjs": "7.8.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.2",
    "@angular-devkit/architect": "0.2201.7",
    "@angular-devkit/core": "22.1.7",
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/angular-vite": "10.6.0",
    "axe-core": "4.13.0",
    "less": "4.9.1",
    "sass": "1.104.1",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}

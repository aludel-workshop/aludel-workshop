+// Files this layer publishes from its records (layer.json `api.publishes`). The host serves each by its content digest.
+export function publish(path, { records = {}, project = {} } = {}) {
+  if (path !== 'kit.js') fail('Design publishes kit.js only.', 404);
+  return { type: 'text/javascript', body: kitSource({ records, project }) };
+}

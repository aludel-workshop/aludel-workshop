+  'nav-item': `:host{display:block}a{position:relative;overflow:hidden;display:flex;gap:12px;align-items:center;min-height:48px;padding:0 16px;border-radius:${v('corner-full')};${type('label-large')};color:${v('on-surface-variant')};text-decoration:none}
+    a[aria-current=page]{background:${v('secondary-container')};color:${v('on-secondary-container')}}`,
+  'nav-list': `:host{display:block;min-width:0}nav{display:grid;gap:4px;padding:12px;background:${v('surface-container-low')};border-radius:${v('corner-large')}}`,
+  'nav-bar': `:host{display:block}nav{display:flex;justify-content:space-around;background:${v('surface-container')};padding:12px 0}`,
+  toolbar: `:host{display:block}header{display:flex;align-items:center;gap:8px;min-height:64px;padding:0 16px;background:${v('surface')};color:${v('on-surface')}}h1{margin:0;${type('title-large')};flex:1}`,
+  scaffold: `:host{display:grid;grid-template-columns:minmax(0,max-content) minmax(0,1fr);gap:16px;background:${v('surface')};color:${v('on-surface')};padding:16px;min-width:0}
+    :host([navigation=Top]){grid-template-columns:minmax(0,1fr)}main{min-width:0;display:grid;gap:16px;align-content:start}`,
+  'list-detail': `:host{display:grid;grid-template-columns:minmax(200px,1fr) 2fr;gap:16px;background:${v('surface')}}`
+};
+const kindRender = {
+  button: (a, slot) => `<button class="sl ${(a.variant || 'Filled').toLowerCase()}"${a.disabled != null || a.state === 'disabled' ? ' disabled' : ''}>${icon(a.icon)}<slot>${esc(a.label)}</slot></button>`,
+  'icon-button': a => `<button class="sl" aria-label="${esc(a.label || a.icon)}"${a.state === 'disabled' ? ' disabled' : ''}>${icon(a.icon || 'more_vert')}</button>`,
+  fab: a => `<button class="sl" aria-label="${esc(a.label)}">${icon(a.icon || 'add')}${a.extended != null ? esc(a.label) : ''}</button>`,
+  card: (a, slot) => `<div class="c ${(a.variant || 'Elevated').toLowerCase()}">${a.media != null ? '<div class="media"></div>' : ''}${a.headline ? `<h3>${esc(a.headline)}</h3>` : ''}${a.supporting ? `<p>${esc(a.supporting)}</p>` : ''}<slot></slot><div class="actions">${slot('actions')}</div></div>`,
+  dialog: (a, slot) => `<div class="d" role="dialog" aria-label="${esc(a.headline)}"><h2>${esc(a.headline)}</h2><p>${esc(a.body)}</p><slot></slot><div class="actions">${slot('actions')}</div></div>`,
+  chip: a => `<button class="sl" aria-pressed="${a.selected != null}">${esc(a.label)}</button>`,
+  switch: a => `<label><button role="switch" aria-checked="${a.on != null}"></button><span>${esc(a.label)}</span></label>`,
+  'text-field': a => `<label class="${(a.variant || 'Filled').toLowerCase()}${a.error != null ? ' err' : ''}"><span class="l">${esc(a.label)}</span><input value="${esc(a.value)}" placeholder="${esc(a.placeholder)}"${a.error != null ? ' aria-invalid="true"' : ''}><span class="h">${a.error != null ? 'Check this and try again' : esc(a.hint)}</span></label>`,
+  list: (a, slot) => `<div role="list">${slot('items')}<slot></slot></div>`,
+  'list-item': a => `<div class="i sl" role="listitem">${a.leading === 'None' ? '' : `<span class="av" aria-hidden="true">${a.leading === 'Icon' ? icon(a.icon || 'eco') : esc(String(a.headline || '?')[0])}</span>`}<span><b>${esc(a.headline)}</b><small>${esc(a.supporting)}</small></span></div>`,
+  'nav-item': a => `<a class="sl" href="${esc(a.href || '#')}"${a.selected != null ? ' aria-current="page"' : ''}>${icon(a.icon || 'home')}${esc(a.label)}${a.badge ? ` <small>${esc(a.badge)}</small>` : ''}</a>`,
+  'nav-list': (a, slot) => `<nav aria-label="${esc(a.label || 'Main')}">${slot('items')}<slot></slot></nav>`,
+  'nav-bar': (a, slot) => `<nav aria-label="${esc(a.label || 'Main')}">${slot('items')}<slot></slot></nav>`,
+  toolbar: (a, slot) => `<header>${a.back != null ? icon('arrow_back') : ''}<slot name="leading"></slot><h1>${esc(a.title)}</h1>${slot('actions')}</header>`,
+  scaffold: (a, slot) => `${slot('navigation')}<main>${slot('content')}<slot></slot></main>`,
+  'list-detail': (a, slot) => `<div>${slot('list')}</div><div>${slot('detail')}<slot></slot></div>`
+};
+// Icons: the contracts name Material Symbols. The kit draws a small glyph table so it needs no font; a page that loads
+// the Material Symbols font can set --kit-icons to use it instead.
+const glyphs = { add: '+', check: '✓', send: '➤', arrow_forward: '→', arrow_back: '←', share: '⇪', close: '✕', favorite: '♥', more_vert: '⋮', edit: '✎', home: '⌂',
+  search: '⌕', settings: '⚙', person: '◉', chat: '✉', inventory_2: '▤', eco: '❦', notifications: '🔔' };
+const elementSlug = value => String(value).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'part';
+
+// Pure: the same records give the same file, so its digest names a revision of the kit.
+export function kitSource({ records = {}, project = {} } = {}) {
+  const tokens = (records.design_tokens || [])[0]?.data;
+  if (!tokens) fail('Design has no token set yet, so there is no kit.', 404);
+  let prefix = elementSlug(project.slug || project.name || 'app').split('-')[0];
+  if (!/^[a-z][a-z0-9]*$/.test(prefix)) prefix = `k${prefix}`;
+  const components = (records.component || []).slice().sort((a, b) => a.id.localeCompare(b.id));
+  const tags = new Map(), used = new Set();
+  for (const component of components) {
+    let tag = `${prefix}-${elementSlug(component.data.name)}`;
+    for (let n = 2; used.has(tag); n++) tag = `${prefix}-${elementSlug(component.data.name)}-${n}`;
+    used.add(tag); tags.set(component.id, tag);
+  }
+  const elements = components.map(({ id, revision, data }) => ({
+    id, revision, tag: tags.get(id), name: data.name, kind: data.preview && kindRender[data.preview] ? data.preview : null,
+    template: data.template || null, props: data.props.map(prop => prop.key), booleans: data.props.filter(prop => prop.kind === 'boolean').map(prop => prop.key),
+    defaults: Object.fromEntries(data.props.filter(prop => prop.kind === 'variant' || prop.kind === 'swap').map(prop => [prop.key, prop.default])),
+    slots: data.slots.map(slot => slot.name),
+    demo: { props: data.demo?.props || {}, slots: Object.fromEntries(Object.entries(data.demo?.slots || {}).map(([name, list]) => [name, list.map(child => ({ tag: tags.get(child.component) || null, props: child.props }))])) }
+  }));
+  const block = vars => Object.entries(vars).map(([name, value]) => `${name}:${value}`).join(';');
+  const themeCss = `:root{${block(tokenVariables(tokens, 'light'))};color-scheme:light}`
+    + `@media (prefers-color-scheme:dark){:root:not([data-theme=light]){${block(tokenVariables(tokens, 'dark'))};color-scheme:dark}}`
+    + `:root[data-theme=dark]{${block(tokenVariables(tokens, 'dark'))};color-scheme:dark}`;
+  const shared = `:host{font:var(--mat-sys-body-large);color:var(--mat-sys-on-surface)}.sl::after{content:"";position:absolute;inset:0;background:currentColor;opacity:0;pointer-events:none;transition:opacity var(--app-duration-short,150ms)}`
+    + `.sl:hover::after,:host([state=hover]) .sl::after{opacity:var(--mat-sys-hover-state-layer-opacity)}.sl:focus-visible::after,:host([state=focus]) .sl::after{opacity:var(--mat-sys-focus-state-layer-opacity)}`
+    + `.sl:active::after,:host([state=pressed]) .sl::after{opacity:var(--mat-sys-pressed-state-layer-opacity)}:focus-visible,:host([state=focus]) .sl{outline:3px solid var(--mat-sys-primary);outline-offset:2px}`
+    + `.ic{font-family:var(--kit-icons,inherit);font-size:18px;line-height:1}`;
+  const kinds = [...new Set(elements.map(element => element.kind).filter(Boolean))];
+  const kindSource = kinds.map(kind => `${JSON.stringify(kind)}:{css:${JSON.stringify(kindCss[kind].replace(/\s*\n\s*/g, ''))},render:${kindRender[kind].toString()}}`).join(',\n');
+  const kit = { name: String(project.name || 'App'), prefix, tokensRevision: (records.design_tokens || [])[0]?.revision || null };
+  return `// ${kit.name}'s design kit, generated by Aludel's Design layer from its records. Change the records, not this file.
+(() => {
+if (window.aludelKit) return;
+const esc = value => String(value ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
+const glyphs = ${JSON.stringify(glyphs)};
+const icon = name => !name || name === 'none' ? '' : '<span class="ic" aria-hidden="true">' + (getComputedStyle(document.documentElement).getPropertyValue('--kit-icons').trim() ? esc(name) : (glyphs[name] || '•')) + '</span>';
+const kinds = {${kindSource}};
+const elements = ${JSON.stringify(elements)};
+const shared = ${JSON.stringify(shared)};
+const theme = document.createElement('style');
+theme.dataset.kit = ${JSON.stringify(prefix)};
+theme.textContent = ${JSON.stringify(themeCss)};
+document.head.append(theme);
+const fill = (html, a) => html.replace(/\\{\\{\\s*([a-zA-Z0-9]+)\\s*\\}\\}/g, (_, key) => esc(a[key]));
+for (const spec of elements) {
+  if (customElements.get(spec.tag)) continue;
+  const kind = kinds[spec.kind];
+  customElements.define(spec.tag, class extends HTMLElement {
+    static observedAttributes = [...spec.props, 'state'];
+    connectedCallback() { this.paint(); }
+    attributeChangedCallback() { if (this.shadowRoot) this.paint(); }
+    paint() {
+      const root = this.shadowRoot || this.attachShadow({ mode: 'open' });
+      const a = { ...spec.defaults };
+      for (const attr of this.attributes) a[attr.name] = attr.value;
+      const slot = name => spec.slots.includes(name) ? '<slot name="' + esc(name) + '"></slot>' : '';
+      if (kind) root.innerHTML = '<style>' + shared + kind.css + '</style>' + kind.render(a, slot);
+      else if (spec.template) root.innerHTML = '<style>' + shared + spec.template.css + '</style>' + fill(spec.template.html, a);
+      else root.innerHTML = '<style>:host{display:block}div{border:2px dashed var(--mat-sys-error);color:var(--mat-sys-error);padding:12px;font:var(--mat-sys-body-medium)}</style><div role="note">' + esc(spec.name) + ": the kit can't draw this yet. It needs a preview kind or a template in Design.</div><slot></slot>";
+      const toggle = root.querySelector('button[aria-pressed],button[role=switch]');
+      if (toggle) toggle.onclick = () => this.toggleAttribute(spec.kind === 'chip' ? 'selected' : 'on');
+    }
+  });
+}
+// A demo of one element: its demo values (a child's own values over them), and its demo children in their slots.
+function demo(tag, values = {}, depth = 0) {
+  const spec = elements.find(entry => entry.tag === tag);
+  const element = document.createElement(tag);
+  if (!spec) return element;
+  for (const [key, value] of Object.entries({ ...spec.demo.props, ...values })) { if (value === true) element.setAttribute(key, ''); else if (value !== false && value !== '') element.setAttribute(key, value); }
+  if (depth < 3) for (const [name, children] of Object.entries(spec.demo.slots)) for (const child of children) {
+    if (!child.tag) continue;
+    const node = demo(child.tag, child.props, depth + 1);
+    node.slot = name; element.append(node);
+  }
+  return element;
+}
+window.aludelKit = Object.freeze({ ...${JSON.stringify(kit)}, elements, demo });
+})();
+`;
+}
+
+// Files this layer publishes from its records (layer.json `api.publishes`). The host serves each by its content digest.
+export function publish(path, { records = {}, project = {} } = {}) {
+  if (path !== 'kit.js') fail('Design publishes kit.js only.', 404);
+  return { type: 'text/javascript', body: kitSource({ records, project }) };
+}

+  dialog: (a, slot) => `<div class="d" role="dialog" aria-label="${esc(a.headline)}"><h2>${esc(a.headline)}</h2><p>${esc(a.body)}</p><slot></slot><div class="actions">${slot('actions')}</div></div>`,
+  chip: a => `<button class="sl" aria-pressed="${a.selected != null}">${esc(a.label)}</button>`,
+  switch: a => `<label><button role="switch" aria-checked="${a.on != null}"></button><span>${esc(a.label)}</span></label>`,
+  'text-field': a => `<label class="${(a.variant || 'Filled').toLowerCase()}${a.error != null ? ' err' : ''}"><span class="l">${esc(a.label)}</span><input value="${esc(a.value)}" placeholder="${esc(a.placeholder)}"${a.error != null ? ' aria-invalid="true"' : ''}><span class="h">${a.error != null ? 'Check this and try again' : esc(a.hint)}</span></label>`,
+  list: (a, slot) => `<div role="list">${slot('items')}<slot></slot></div>`,
+  'list-item': a => `<div class="i sl" role="listitem">${a.leading === 'None' ? '' : `<span class="av" aria-hidden="true">${a.leading === 'Icon' ? icon(a.icon || 'eco') : esc(String(a.headline || '?')[0])}</span>`}<span><b>${esc(a.headline)}</b><small>${esc(a.supporting)}</small></span></div>`,
+  'nav-item': a => `<a class="sl" href="${esc(a.href || '#')}"${a.selected != null ? ' aria-current="page"' : ''}>${icon(a.icon || 'home')}${esc(a.label)}${a.badge ? ` <small>${esc(a.badge)}</small>` : ''}</a>`,

+  const block = vars => Object.entries(vars).map(([name, value]) => `${name}:${value}`).join(';');
+  const themeCss = `:root{${block(tokenVariables(tokens, 'light'))};color-scheme:light}`
+    + `@media (prefers-color-scheme:dark){:root:not([data-theme=light]){${block(tokenVariables(tokens, 'dark'))};color-scheme:dark}}`
+    + `:root[data-theme=dark]{${block(tokenVariables(tokens, 'dark'))};color-scheme:dark}`;
+  const shared = `:host{font:var(--mat-sys-body-large);color:var(--mat-sys-on-surface)}.sl::after{content:"";position:absolute;inset:0;background:currentColor;opacity:0;pointer-events:none;transition:opacity var(--app-duration-short,150ms)}`
+    + `.sl:hover::after,:host([state=hover]) .sl::after{opacity:var(--mat-sys-hover-state-layer-opacity)}.sl:focus-visible::after,:host([state=focus]) .sl::after{opacity:var(--mat-sys-focus-state-layer-opacity)}`
+    + `.sl:active::after,:host([state=pressed]) .sl::after{opacity:var(--mat-sys-pressed-state-layer-opacity)}:focus-visible,:host([state=focus]) .sl{outline:3px solid var(--mat-sys-primary);outline-offset:2px}`

+const glyphs = { add: '+', check: '✓', send: '➤', arrow_forward: '→', arrow_back: '←', share: '⇪', close: '✕', favorite: '♥', more_vert: '⋮', edit: '✎', home: '⌂',
+  search: '⌕', settings: '⚙', person: '◉', chat: '✉', inventory_2: '▤', eco: '❦', notifications: '🔔' };
+const elementSlug = value => String(value).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'part';
+
+// Pure: the same records give the same file, so its digest names a revision of the kit.
+export function kitSource({ records = {}, project = {} } = {}) {
+  const tokens = (records.design_tokens || [])[0]?.data;
+  if (!tokens) fail('Design has no token set yet, so there is no kit.', 404);
+  let prefix = elementSlug(project.slug || project.name || 'app').split('-')[0];
+  if (!/^[a-z][a-z0-9]*$/.test(prefix)) prefix = `k${prefix}`;
+  const components = (records.component || []).slice().sort((a, b) => a.id.localeCompare(b.id));
+  const tags = new Map(), used = new Set();
+  for (const component of components) {
+    let tag = `${prefix}-${elementSlug(component.data.name)}`;
+    for (let n = 2; used.has(tag); n++) tag = `${prefix}-${elementSlug(component.data.name)}-${n}`;
+    used.add(tag); tags.set(component.id, tag);
+  }
+  const elements = components.map(({ id, revision, data }) => ({
+    id, revision, tag: tags.get(id), name: data.name, kind: data.preview && kindRender[data.preview] ? data.preview : null,
+    template: data.template || null, props: data.props.map(prop => prop.key), booleans: data.props.filter(prop => prop.kind === 'boolean').map(prop => prop.key),
+    defaults: Object.fromEntries(data.props.filter(prop => prop.kind === 'variant' || prop.kind === 'swap').map(prop => [prop.key, prop.default])),
+    slots: data.slots.map(slot => slot.name),
+    demo: { props: data.demo?.props || {}, slots: Object.fromEntries(Object.entries(data.demo?.slots || {}).map(([name, list]) => [name, list.map(child => ({ tag: tags.get(child.component) || null, props: child.props }))])) }

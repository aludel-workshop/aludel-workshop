+  const kit = { name: String(project.name || 'App'), prefix, tokensRevision: (records.design_tokens || [])[0]?.revision || null };
+  return `// ${kit.name}'s design kit, generated by Aludel's Design layer from its records. Change the records, not this file.
+(() => {
+if (window.aludelKit) return;
+const esc = value => String(value ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

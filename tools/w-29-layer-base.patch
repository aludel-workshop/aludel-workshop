+const icon = name => !name || name === 'none' ? '' : '<span class="ic" aria-hidden="true">' + (getComputedStyle(document.documentElement).getPropertyValue('--kit-icons').trim() ? esc(name) : (glyphs[name] || '•')) + '</span>';
+const kinds = {${kindSource}};
+const elements = ${JSON.stringify(elements)};
+const shared = ${JSON.stringify(shared)};
+const theme = document.createElement('style');
+theme.dataset.kit = ${JSON.stringify(prefix)};
+theme.textContent = ${JSON.stringify(themeCss)};
+document.head.append(theme);
+const fill = (html, a) => html.replace(/\\{\\{\\s*([a-zA-Z0-9]+)\\s*\\}\\}/g, (_, key) => esc(a[key]));
+for (const spec of elements) {
+  if (customElements.get(spec.tag)) continue;
+  const kind = kinds[spec.kind];
